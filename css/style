/* ==========================================================
   Marketplace UNP - style.css
   Tema: papan pengumuman kampus. Indigo + kuning, harga ala label barang.
   ========================================================== */
@import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=Figtree:wght@400;500;600;700&display=swap');

:root {
  --ink: #161a3d;
  --indigo: #2d34a5;
  --indigo-dark: #222885;
  --indigo-soft: #e8e9fb;
  --marigold: #ffb927;
  --marigold-soft: #fff2cf;
  --chalk: #f5f6fb;
  --paper: #ffffff;
  --line: #e1e3f0;
  --muted: #646a8a;
  --mint: #13966b;
  --mint-soft: #dcf5ea;
  --coral: #e2484d;
  --coral-soft: #fde4e5;
  --font-display: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif;
  --font-body: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --nav-h: 64px;
}

*, *::before, *::after { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.55;
  color: var(--ink);
  background: var(--chalk);
}

a { color: var(--indigo); }
img { max-width: 100%; }

:focus-visible {
  outline: 3px solid var(--marigold);
  outline-offset: 2px;
}

/* ---------- Navbar ---------- */
.navbar {
  position: sticky;
  top: 0;
  z-index: 50;
  height: var(--nav-h);
  padding: 0 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--indigo);
  color: #fff;
}
.navbar-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.25rem;
  color: #fff;
  text-decoration: none;
}
.navbar-brand span {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  background: var(--marigold);
  border-radius: 10px;
  transform: rotate(-6deg);
  font-size: 1.1rem;
}
.nav-user {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 500;
  font-size: .95rem;
}
.role-badge {
  padding: 2px 10px;
  border-radius: 999px;
  font-size: .7rem;
  font-weight: 700;
  background: rgba(255,255,255,.18);
  color: #fff;
}
.role-badge.role-admin { background: var(--marigold); color: var(--ink); }
.btn-logout {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  font: 600 .9rem var(--font-body);
  color: #fff;
  background: transparent;
  border: 1.5px solid rgba(255,255,255,.45);
  border-radius: 10px;
  cursor: pointer;
  transition: background .15s, border-color .15s;
}
.btn-logout:hover { background: rgba(255,255,255,.14); border-color: #fff; }

/* ---------- Layout ---------- */
.page-wrapper {
  display: flex;
  min-height: calc(100vh - var(--nav-h));
}
.sidebar {
  flex: 0 0 248px;
  position: sticky;
  top: var(--nav-h);
  align-self: flex-start;
  height: calc(100vh - var(--nav-h));
  overflow-y: auto;
  padding: 20px 14px;
  background: var(--paper);
  border-right: 1px solid var(--line);
}
.sidebar-title {
  padding: 8px 14px 6px;
  font-size: .8rem;
  font-weight: 700;
  color: var(--muted);
}
.sidebar-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  margin-bottom: 2px;
  border-radius: 10px;
  font-weight: 600;
  font-size: .95rem;
  color: var(--ink);
  text-decoration: none;
  transition: background .15s, color .15s;
}
.sidebar-link i { width: 18px; text-align: center; color: var(--indigo); }
.sidebar-link:hover { background: var(--indigo-soft); }
.sidebar-link.active { background: var(--indigo); color: #fff; }
.sidebar-link.active i { color: var(--marigold); }
.notif-badge {
  margin-left: auto;
  min-width: 22px;
  padding: 0 7px;
  text-align: center;
  font-size: .72rem;
  font-weight: 700;
  line-height: 22px;
  color: #fff;
  background: var(--coral);
  border-radius: 999px;
}
.content-area {
  flex: 1;
  min-width: 0;
  max-width: 1200px;
  padding: 32px 36px 56px;
}

/* ---------- Page header ---------- */
.page-header { margin-bottom: 26px; }
.page-header h1 {
  margin: 0 0 4px;
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 2rem;
  letter-spacing: -.02em;
  line-height: 1.15;
}
.page-header p { margin: 0; color: var(--muted); }

/* ---------- Cards ---------- */
.card {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 16px;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 22px;
  border-bottom: 1px solid var(--line);
}
.card-title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.1rem;
}
.card-body { padding: 22px; }

/* ---------- Statistik ---------- */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 16px;
  margin-bottom: 28px;
}
.stat-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 14px;
}
.stat-icon {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  width: 50px;
  height: 50px;
  border-radius: 12px;
  font-size: 1.4rem;
}
.stat-icon.blue   { background: var(--indigo-soft); }
.stat-icon.green  { background: var(--mint-soft); }
.stat-icon.yellow { background: var(--marigold-soft); }
.stat-icon.red    { background: var(--coral-soft); }
.stat-value {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.75rem;
  line-height: 1.1;
}
.stat-label { font-size: .88rem; color: var(--muted); }

/* ---------- Produk ---------- */
.produk-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 20px;
}
.produk-card {
  display: block;
  overflow: hidden;
  color: inherit;
  text-decoration: none;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 16px;
  transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}
.produk-card:hover {
  transform: translateY(-4px);
  border-color: var(--indigo);
  box-shadow: 0 14px 28px -14px rgba(45, 52, 165, .45);
}
.produk-card > img {
  display: block;
  width: 100%;
  height: 190px;
  object-fit: cover;
}
.produk-noimg {
  display: grid;
  place-items: center;
  height: 190px;
  font-size: 3.2rem;
  background-color: var(--indigo-soft);
  background-image: radial-gradient(#c6c9ee 1.3px, transparent 1.3px);
  background-size: 14px 14px;
}
.produk-info { padding: 14px 16px 16px; }
.produk-info h4 {
  margin: 0 0 8px;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.02rem;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
/* Harga ditampilkan sebagai label harga barang */
.produk-harga {
  display: inline-block;
  margin: 0 0 10px;
  padding: 4px 14px 4px 22px;
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.02rem;
  color: var(--ink);
  background:
    radial-gradient(circle at 11px 50%, var(--ink) 0 2.2px, transparent 2.8px),
    var(--marigold);
  clip-path: polygon(13px 0, 100% 0, 100% 100%, 13px 100%, 0 50%);
}
.produk-meta { margin: 0 0 6px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.produk-penjual { margin: 0; font-size: .85rem; color: var(--muted); }

/* ---------- Badge ---------- */
.badge {
  display: inline-block;
  padding: 3px 11px;
  font-size: .75rem;
  font-weight: 700;
  line-height: 1.5;
  border-radius: 999px;
  background: var(--indigo-soft);
  color: var(--indigo-dark);
}
.badge-diproses, .badge-dikonfirmasi { background: var(--indigo-soft); color: var(--indigo-dark); }
.badge-admin, .badge-pending         { background: var(--marigold-soft); color: #8a5a00; }
.badge-tersedia, .badge-selesai      { background: var(--mint-soft); color: #0b6b4b; }
.badge-terjual, .badge-dibatalkan, .badge-dihapus { background: var(--coral-soft); color: #a92b30; }

/* ---------- Tombol ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  font: 600 .95rem var(--font-body);
  color: var(--ink);
  text-decoration: none;
  background: var(--paper);
  border: 1.5px solid transparent;
  border-radius: 10px;
  cursor: pointer;
  transition: background .15s, color .15s, border-color .15s, transform .1s;
}
.btn:active { transform: translateY(1px); }
.btn-primary { background: var(--indigo); color: #fff; }
.btn-primary:hover { background: var(--indigo-dark); }
.btn-success { background: var(--mint); color: #fff; }
.btn-success:hover { background: #0e7d58; }
.btn-danger { background: var(--coral); color: #fff; }
.btn-danger:hover { background: #c93a3f; }
.btn-warning { background: var(--marigold); color: var(--ink); }
.btn-warning:hover { background: #f0a808; }
.btn-outline { background: transparent; color: var(--indigo); border-color: var(--indigo); }
.btn-outline:hover { background: var(--indigo-soft); }
.btn-sm { padding: 6px 12px; font-size: .85rem; border-radius: 8px; }

/* ---------- Form ---------- */
.form-group { margin-bottom: 16px; }
.form-label {
  display: block;
  margin-bottom: 6px;
  font-size: .9rem;
  font-weight: 600;
}
.form-control {
  width: 100%;
  padding: 11px 14px;
  font: 500 1rem var(--font-body);
  color: var(--ink);
  background: var(--paper);
  border: 1.5px solid var(--line);
  border-radius: 10px;
  transition: border-color .15s, box-shadow .15s;
}
.form-control::placeholder { color: #9a9fbc; }
.form-control:focus {
  outline: none;
  border-color: var(--indigo);
  box-shadow: 0 0 0 4px rgba(45, 52, 165, .14);
}
textarea.form-control { resize: vertical; min-height: 100px; }
.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 4px 20px;
  margin-bottom: 8px;
}
.form-full { grid-column: 1 / -1; }

/* ---------- Alert ---------- */
.alert {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  padding: 12px 16px;
  font-size: .93rem;
  font-weight: 500;
  border-radius: 10px;
  border-left: 4px solid;
}
.alert-danger  { background: var(--coral-soft); color: #8f2227; border-color: var(--coral); }
.alert-success { background: var(--mint-soft);  color: #0b5b40; border-color: var(--mint); }

/* ---------- Tabel (untuk halaman admin & pesanan) ---------- */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
th {
  padding: 12px 16px;
  text-align: left;
  font-size: .82rem;
  font-weight: 700;
  color: var(--muted);
  background: var(--chalk);
  white-space: nowrap;
}
td { padding: 14px 16px; border-top: 1px solid var(--line); vertical-align: middle; }
tbody tr:hover { background: #fafbff; }

/* ---------- Empty state ---------- */
.empty-state { padding: 40px 16px; text-align: center; color: var(--muted); }
.empty-icon { margin-bottom: 8px; font-size: 3rem; }

/* ---------- Login & Daftar ---------- */
.login-page {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 100vh;
  padding: 32px 16px;
  overflow: hidden;
  background: var(--indigo);
}
.login-page::before,
.login-page::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.login-page::before {
  top: -140px;
  right: -120px;
  width: 420px;
  height: 420px;
  background: var(--marigold);
}
.login-page::after {
  bottom: -180px;
  left: -140px;
  width: 460px;
  height: 460px;
  background: var(--indigo-dark);
}
.login-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 420px;
  padding: 36px 34px 30px;
  background: var(--paper);
  border-radius: 20px;
  box-shadow: 0 30px 60px -20px rgba(10, 14, 60, .55);
}
.login-logo { margin-bottom: 24px; text-align: center; }
.logo-icon {
  display: inline-grid;
  place-items: center;
  width: 62px;
  height: 62px;
  margin-bottom: 12px;
  font-size: 1.8rem;
  background: var(--marigold);
  border-radius: 16px;
  transform: rotate(-6deg);
}
.login-logo h1 {
  margin: 0 0 4px;
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.7rem;
  letter-spacing: -.02em;
}
.login-logo p { margin: 0; font-size: .92rem; color: var(--muted); }

/* ---------- Responsif ---------- */
@media (max-width: 900px) {
  .navbar { padding: 0 16px; }
  .nav-user { font-size: .85rem; }
  .page-wrapper { display: block; }
  .sidebar {
    position: static;
    display: flex;
    gap: 6px;
    height: auto;
    padding: 10px 12px;
    overflow-x: auto;
    border-right: none;
    border-bottom: 1px solid var(--line);
  }
  .sidebar-title { display: none; }
  .sidebar-link { flex: 0 0 auto; margin: 0; white-space: nowrap; }
  .content-area { padding: 22px 16px 44px; }
  .page-header h1 { font-size: 1.6rem; }
  .form-grid { grid-template-columns: 1fr; }
  /* grid dua kolom di halaman detail produk */
  .content-area > div[style*="grid-template-columns"] { grid-template-columns: 1fr !important; }
}

@media (max-width: 520px) {
  .nav-user { display: none; }
  .produk-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .produk-card > img, .produk-noimg { height: 140px; }
  .login-card { padding: 28px 22px 24px; }
}

/* ---------- Tambahan: halaman produk, pesanan, admin ---------- */
.muted { color: var(--muted); }
.small { font-size: .85rem; }
.nowrap { white-space: nowrap; }
.mb { margin-bottom: 20px; }
.sep { border: none; border-top: 1px solid var(--line); margin: 16px 0; }
.alert-warning { background: var(--marigold-soft); color: #6b4500; border-color: var(--marigold); }
.alert a { font-weight: 700; }

.page-header.split { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: start; }
.filter-bar { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; }
.form-hint { display: block; margin-top: 6px; font-size: .82rem; color: var(--muted); }
.img-preview { max-width: 220px; max-height: 180px; margin-bottom: 10px; border-radius: 12px; border: 1px solid var(--line); object-fit: cover; }

.detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
.detail-foto { max-width: 100%; max-height: 420px; border-radius: 12px; object-fit: contain; }
.detail-noimg { height: 300px; font-size: 6rem; border-radius: 12px; }
.detail-judul { margin: 0 0 10px; font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; line-height: 1.2; letter-spacing: -.01em; }
.harga-besar { margin-bottom: 14px; padding: 7px 20px 7px 30px; font-size: 1.5rem;
  background: radial-gradient(circle at 15px 50%, var(--ink) 0 3px, transparent 3.6px), var(--marigold);
  clip-path: polygon(18px 0, 100% 0, 100% 100%, 18px 100%, 0 50%); }
.detail-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.total-box { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; padding: 14px 16px; background: var(--chalk); border-radius: 10px; }
.total-box strong { font-family: var(--font-display); font-size: 1.3rem; }

.thumb { flex: 0 0 auto; width: 48px; height: 48px; border-radius: 10px; object-fit: cover; border: 1px solid var(--line); }
.thumb-lg { width: 84px; height: 84px; border-radius: 14px; }
.thumb-ph { display: grid; place-items: center; font-size: 1.4rem; background: var(--indigo-soft); }
.thumb-lg.thumb-ph { font-size: 2.2rem; }
.cell-produk { display: flex; align-items: center; gap: 12px; color: inherit; text-decoration: none; }
.cell-produk:hover strong { color: var(--indigo); }

.inline-form { display: inline; margin: 0; }
.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }

.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
.chip { padding: 7px 16px; font-size: .9rem; font-weight: 600; color: var(--ink); text-decoration: none; background: var(--paper); border: 1.5px solid var(--line); border-radius: 999px; transition: background .15s, border-color .15s; }
.chip:hover { border-color: var(--indigo); }
.chip.active { background: var(--indigo); border-color: var(--indigo); color: #fff; }

details.reset { position: relative; }
details.reset summary { list-style: none; cursor: pointer; }
details.reset summary::-webkit-details-marker { display: none; }
.reset-form { position: absolute; right: 0; z-index: 5; display: flex; gap: 8px; width: 290px; margin-top: 6px; padding: 12px; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 16px 32px -16px rgba(22, 26, 61, .4); }

@media (max-width: 900px) {
  .grid-2, .detail-grid { grid-template-columns: 1fr; }
  .reset-form { left: 0; right: auto; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; animation: none !important; }
}
